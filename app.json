{
  "expo": {
    "name": "Wayfare",
    "slug": "trip-route-planner",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fariyam.wayfare",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo.png",
          "imageWidth": 100,
          "resizeMode": "contain",
          "backgroundColor": "#F3F5F7"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Wayfare to use your location to set your pickup or drop-off."
        }
      ]
    ],
    "extra": {
      "androidMapsConfigured": false,
      "eas": {
        "projectId": "195bc3f9-712b-4828-9079-251147176d12"
      }
    }
  }
}
